# Trust the X-Forwarded-Proto header for HTTPS detection. Default: False.
# Set to True ONLY when the app runs behind a trusted reverse proxy that
# overwrites/strips X-Forwarded-Proto, and direct access to the app is blocked.
# Required with SECURE_SSL_REDIRECT when TLS terminates at the proxy, otherwise
# Django sees internal HTTP and redirect-loops. Enabling it while the header is
# client-controllable lets callers spoof HTTPS (e.g. defeat SECURE_SSL_REDIRECT).
TRUST_X_FORWARDED_PROTO=False

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
